<!DOCTYPE html>
<html>
<head>
<title>Universities in Europe</title>

<style>
body {
    font-family: Arial;
    margin: 0;
}

/* NAVBAR */
.navbar {
    display: flex;
    background: #003366;
}

.navbar button {
    flex: 1;
    padding: 14px;
    border: none;
    background: white;
    cursor: pointer;
    font-weight: bold;
}

.navbar button.active {
    background: #ffcc00;
}

/* TAB CONTENT */
.tab {
    display: none;
    padding: 20px;
    background: #f5f5f5;
}

.card {
    background: white;
    padding: 15px;
    margin: 12px 0;
    border-radius: 10px;
}

.info-line {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 8px;
}

.apply {
    display: inline-block;
    margin-top: 10px;
    padding: 8px 12px;
    background: black;
    color: white;
    text-decoration: none;
}

.map-link {
    color: #007bff;
    text-decoration: none;
}

.badge {
    background: gold;
    padding: 4px 8px;
    border-radius: 6px;
    font-size: 12px;
}
</style>
</head>

<body>

<!-- NAVBAR -->
<div class="navbar">
<button onclick="openTab('lux')" class="active">Luxembourg</button>
<button onclick="openTab('nl')">Netherlands</button>
</div>

<!-- ================= LUXEMBOURG ================= -->
<div id="lux" class="tab" style="display:block;">
<h2>🇱🇺 Universities in Luxembourg</h2>

